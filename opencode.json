{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "waibee": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Waibee",
      "options": {
        "baseURL": "https://api.waibee.com/v1",
        "apiKey": "{env:WAIBEE_API_KEY}"
      },
      "models": {
        "waibee/auto": { "name": "Waibee Auto (роутинг)" },
        "openai/gpt-5.2-codex":          { "name": "GPT-5.2 Codex",     "limit": { "context": 400000,  "output": 128000 } },
        "openai/gpt-5.1-codex-max":      { "name": "GPT-5.1 Codex Max", "limit": { "context": 400000,  "output": 128000 } },
        "openai/gpt-5.4":                { "name": "GPT-5.4",           "limit": { "context": 1050000, "output": 128000 } },
        "google/gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro",   "limit": { "context": 1048576, "output": 65536 } },
        "qwen/qwen3-coder":              { "name": "Qwen3 Coder 480B",  "limit": { "context": 1048576, "output": 65536 } },
        "qwen/qwen3-coder-plus":         { "name": "Qwen3 Coder Plus",  "limit": { "context": 1000000, "output": 65536 } },
        "moonshotai/kimi-k2-thinking":   { "name": "Kimi K2 Thinking",  "limit": { "context": 262144,  "output": 262144 } },
        "moonshotai/kimi-k2.7-code":     { "name": "Kimi K2.7 Code",    "limit": { "context": 262144,  "output": 16384  } },
        "deepseek/deepseek-v4-pro":      { "name": "DeepSeek V4 Pro",   "limit": { "context": 1048576, "output": 384000 }, "cost": { "input": 0.66, "output": 1.98, "cache_read": 0.022, "cache_write": 0.66 } }
      }
    },
    "waibee-claude": {
      "npm": "@ai-sdk/anthropic",
      "name": "Waibee (Claude, cached)",
      "options": {
        "baseURL": "https://api.waibee.com/v1",
        "apiKey": "{env:WAIBEE_API_KEY}"
      },
      "models": {
        "anthropic/claude-opus-4.8":   { "name": "Claude Opus 4.8",   "limit": { "context": 1000000, "output": 128000 } },
        "anthropic/claude-sonnet-4.6": { "name": "Claude Sonnet 4.6", "limit": { "context": 1000000, "output": 128000 } },
        "anthropic/claude-haiku-4.5":  { "name": "Claude Haiku 4.5",  "limit": { "context": 200000,  "output": 64000  } }
      }
    }
  },
  "mcp": {
    "gitlab": {
      "type": "remote",
      "url": "https://mcp-gitlab.int.wnf.rocks/sse",
      "headers": {
        "Authorization": "Bearer {env:GITLAB_MCP_TOKEN}"
      }
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp-atlassian-preprod.int.wnf.rocks/mcp"
    },
    "opensearch": {
      "type": "remote",
      "url": "https://mcp-opensearch.int.wnf.rocks/mcp/"
    },
    "grafana": {
      "type": "remote",
      "url": "https://mcp-grafana-preprod.int.wnf.rocks/mcp"
    }
  }
}
