# Copy to ~/.cursor/.env or export in your shell before starting Cursor.
# Never commit a file that contains real tokens.

# Required for GitLab MCP (Bearer token)
GITLAB_MCP_TOKEN=

# Required for Waibee provider
WAIBEE_API_KEY=

# Optional: override default URLs (normally not needed)
# GITLAB_MCP_URL=https://mcp-gitlab.int.wnf.rocks/sse
# OPENSEARCH_MCP_URL=https://mcp-opensearch.int.wnf.rocks/mcp/
# ATLASSIAN_MCP_URL=https://mcp-atlassian-preprod.int.wnf.rocks/mcp
# GRAFANA_MCP_URL=https://mcp-grafana-preprod.int.wnf.rocks/mcp
